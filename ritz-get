#!/bin/sh
# ritz-get - build, update and remove Ritze03's programs from git clones. POSIX sh.
# Each program lives as a clone in the repo folder; the clone is the state.
# Output contract for the GUI: PORCELAIN.md. Env: RITZ_GET_GIT_BASE (default https://github.com),
# RITZ_GET_MANIFEST, RITZ_GET_TIMEOUT (seconds, default 3600), RITZ_GET_OS_RELEASE (all for tests),
# RITZ_GET_GUI (set by the GUI), RITZ_GET_SUDO (pkexec from the GUI).
set -u
SPEC=1
US=$(printf '\037')
BASE=${RITZ_GET_GIT_BASE:-https://github.com}
MF=${RITZ_GET_MANIFEST:-$(dirname "$(readlink -f "$0")")/programs}
CFGF=${XDG_CONFIG_HOME:-$HOME/.config}/ritz-get/config
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/ritz-get
YES= BR= OFFLINE= ALL= PORC= EXPL= WANT=
EXIT=0 UP=0 SK=0 FL=0 FNAMES=
export GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30

err() { echo "ritz-get: $*" >&2; }
die() { err "$*"; exit 1; }
usage_err() { err "$*"; exit 2; }
# bump KIND: remember the worst exit code (3 beats 4 beats 1)
bump() { case $1 in 3) EXIT=3 ;; 4) [ "$EXIT" = 3 ] || EXIT=4 ;; *) [ "$EXIT" != 0 ] || EXIT=$1 ;; esac; }
failed() { echo "$1: FAILED ($2)"; FL=$((FL + 1)); FNAMES="$FNAMES $1"; bump "${3:-1}"; }
fail() { failed "$@"; echo "FAILED — your installed version is unchanged and still works"; }
unknown() { err "unknown program: $1 (see: ritz-get list)"; bump 1; }
valid() { case $1 in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) err "invalid program name: $1"; bump 1; return 1 ;; esac; }

usage() {
	cat <<'USAGE'
usage: ritz-get COMMAND [OPTIONS]

  list [NAME...] [--offline] [--all] [--porcelain]
                                  programs, what is installed, what is behind
  install NAME... [--branch B]    clone, build and install (installed: repair)
  update [NAME...] [--yes]        update ritz-get, then rebuild programs that changed
  remove NAME...                  uninstall and delete the clone (alias: uninstall)
  branches NAME                   branches of the remote, current one marked
  switch NAME BRANCH              check out another branch and rebuild
  reset NAME [--yes]              discard local changes: re-clone and rebuild
  hold NAME | unhold NAME         leave NAME out of 'update' without a name
  help
USAGE
}

# ---- config, manifest ------------------------------------------------------------------
cfg() { [ -r "$CFGF" ] && sed -n "s/^$1=//p" "$CFGF" | tail -n 1; }

# load_mf: parse the manifest into $TMP/mf, one record per line, fields joined by $US:
#   E sec name source branch desc title      (title defaults to name)
#   S name text                              (one per setup: line, after its E)
load_mf() {
	[ -r "$MF" ] || die "manifest not found: $MF"
	awk -v US="$US" '
	function flush(   t) {
		if (name == "") return
		t = (title == "" ? name : title)
		print "E" US sec US name US src US br US desc US t
		printf "%s", setups
		name = ""
	}
	BEGIN { sec = "Software" }
	{ sub(/\r$/, ""); gsub(/\t/, " ") }
	/^ *(#|$)/ { next }
	/^\[/ { flush(); sec = $0; sub(/^\[/, "", sec); sub(/\] *$/, "", sec); next }
	/^ / {
		l = $0; sub(/^ +/, "", l)
		if (name == "") next
		if (l ~ /^title:/ && title == "") { sub(/^title: */, "", l); title = l }
		else if (l ~ /^setup:/) { sub(/^setup: */, "", l); setups = setups "S" US name US l "\n" }
		next
	}
	{
		flush()
		d = ""; r = $0
		if (match(r, /"[^"]*"/)) { d = substr(r, RSTART + 1, RLENGTH - 2); r = substr(r, 1, RSTART - 1) }
		n = split(r, f, " ")
		if (n < 2 || f[1] !~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/) next
		name = f[1]; src = f[2]; br = (n > 2 ? f[3] : ""); desc = d; title = ""; setups = ""
	}
	END { flush() }' "$MF" >"$TMP/mf"
}

# lookup NAME: sets SEC SRC DEFBR DESC TITLE KIND from the manifest; rc 1 when unlisted
lookup() {
	l=$(awk -F"$US" -v n="$1" '$1=="E" && $3==n {print; exit}' "$TMP/mf")
	[ -n "$l" ] || return 1
	IFS=$US read -r _ SEC _ SRC DEFBR DESC TITLE <<EOF
$l
EOF
	case $SRC in http://*|https://*) KIND=website ;; *) KIND=program ;; esac
}

setup_lines() {
	awk -F"$US" -v n="$1" '$1=="S" && $2==n { if (!s++) print "Additional steps required:"; print "  " $3 }' "$TMP/mf"
}

# ---- clone state -----------------------------------------------------------------------
is_installed() { [ -e "$SRCDIR/$1/.git" ]; }
branch() { git -C "$SRCDIR/$1" rev-parse --abbrev-ref HEAD; }
short() { git -C "$SRCDIR/$1" rev-parse --short HEAD; }
held() { [ "$(git -C "$SRCDIR/$1" config --get ritz-get.hold)" = true ]; }
# changes NAME: sets DIRTY (changed files) and AHEAD (local commits); modified = either > 0
changes() {
	DIRTY=$(git -C "$SRCDIR/$1" --no-optional-locks status --porcelain 2>/dev/null | awk 'END { print NR }')
	AHEAD=$(git -C "$SRCDIR/$1" rev-list --count '@{u}..HEAD' 2>/dev/null) || AHEAD=0
	[ -n "$AHEAD" ] || AHEAD=0
}
modified() { changes "$1"; [ "$DIRTY" -gt 0 ] || [ "$AHEAD" -gt 0 ]; }
# unlisted: installed clones that are not in the manifest
unlisted() {
	for d in "$SRCDIR"/*/; do
		[ -e "${d}.git" ] || continue
		n=${d%/}; n=${n##*/}
		case $n in *[!A-Za-z0-9._-]*) continue ;; esac
		awk -F"$US" -v n="$n" '$1=="E" && $3==n {f=1} END {exit !f}' "$TMP/mf" || echo "$n"
	done
}

# ---- running install.sh ----------------------------------------------------------------
# run_script NAME ARG: install.sh output streams live; stderr is also kept in $TMP/err.
# Sets RC; collects "missing:" (exit 3) and "needs root:" (exit 4) lines.
run_script() {
	TMO=${RITZ_GET_TIMEOUT:-3600}
	{ { (cd "$SRCDIR/$1" && RITZ_GET_SPEC=$SPEC NO_COLOR=1 TERM=dumb RITZ_GET_SUDO=$SUDO \
		timeout -k 10 "$TMO" ./install.sh "$2" --yes </dev/null 9>&-)
	    echo $? >"$TMP/rc"; } 2>&1 1>&3 | tee "$TMP/err" >&2; } 3>&1
	RC=$(cat "$TMP/rc")
	[ "$RC" != 3 ] || grep '^missing:' "$TMP/err" >>"$TMP/missing"
	[ "$RC" != 4 ] || grep '^needs root:' "$TMP/err" >>"$TMP/rootneed"
	return 0
}

# build NAME: run the clone's install.sh --install.
# rc 0 ok, 2 needs a newer ritz-get, 1 failed (BK = exit class 1|3|4, WHY = reason)
build() {
	BK=1 WHY=
	[ -x "$SRCDIR/$1/install.sh" ] || { WHY="no executable install.sh in the repo"; return 1; }
	v=$(head -n 5 "$SRCDIR/$1/install.sh" | sed -n 's/^# *ritz-get-spec: *\([0-9][0-9]*\).*/\1/p' | head -n 1)
	[ "${v:-1}" -le "$SPEC" ] || return 2
	run_script "$1" --install
	case $RC in
	0) return 0 ;;
	3) BK=3 WHY="needs: $(sed -n 's/^missing: \([^ ]*\).*/\1/p' "$TMP/err" | tr '\n' ' ' | sed 's/ $//; s/ /, /g')" ;;
	4) BK=4 WHY="needs root; run: ritz-get install $1" ;;
	124) if [ "$TMO" -ge 60 ]; then WHY="timed out after $((TMO / 60)) min"; else WHY="timed out after ${TMO}s"; fi ;;
	*) WHY="install.sh exit $RC" ;;
	esac
	return 1
}

# print_deps: one copy-paste line for everything the programs reported missing
print_deps() {
	[ -s "$TMP/missing" ] || return 0
	sort -u "$TMP/missing" >"$TMP/m2"
	ids= pm=
	osr=${RITZ_GET_OS_RELEASE:-/etc/os-release}
	[ -r "$osr" ] && ids=$(. "$osr" >/dev/null 2>&1; echo " ${ID:-} ${ID_LIKE:-} ")
	case $ids in
	*" arch "*|*" cachyos "*) pm=pacman c="sudo pacman -S --needed" ;;
	*" fedora "*|*" rhel "*) pm=dnf c="sudo dnf install" ;;
	*" debian "*|*" ubuntu "*) pm=apt c="sudo apt install" ;;
	esac
	pk=
	while IFS= read -r l; do
		p=
		[ -z "$pm" ] || p=$(printf '%s\n' "$l" | sed -n "s/.*[ (]$pm:\([^ )]*\).*/\1/p" | tr , ' ')
		if [ -n "$p" ]; then pk="$pk $p"; else printf '%s\n' "$l"; fi
	done <"$TMP/m2"
	# shellcheck disable=SC2086
	[ -z "$pk" ] || echo "deps: $c $(printf '%s\n' $pk | sort -u | tr '\n' ' ' | sed 's/ $//')"
}

finish() {
	print_deps
	[ ! -s "$TMP/rootneed" ] || sort -u "$TMP/rootneed"
	exit "$EXIT"
}

# ---- install / remove ------------------------------------------------------------------
# cleanup_fresh NAME CREATED: undo a failed first install (remove links, then the clone)
cleanup_fresh() {
	run_script "$1" --remove >/dev/null 2>&1
	if [ -n "$2" ]; then rm -rf "${SRCDIR:?}/$1"
	else rm -rf "${SRCDIR:?}/$1"/* "$SRCDIR/$1"/.[!.]* 2>/dev/null; fi
}

install_one() {
	n=$1 d=$SRCDIR/$1
	valid "$n" || return 0
	lookup "$n" || { unknown "$n"; return 0; }
	[ "$KIND" = program ] || { err "$n is a website, nothing to install"; bump 1; return 0; }
	fresh= created=
	if is_installed "$n"; then
		[ -z "$BR" ] || { err "$n: already installed; to change branch: ritz-get switch $n $BR"; bump 1; return 0; }
		echo "$n: installed, repairing (re-running install.sh)"
	else
		b=${BR:-$DEFBR}
		[ -e "$d" ] || created=1
		echo "$n: cloning $SRC${b:+ ($b)}"
		mkdir -p "$SRCDIR" || { failed "$n" "cannot create $SRCDIR"; return 0; }
		# shellcheck disable=SC2086
		git clone -q ${b:+-b "$b"} "$BASE/$SRC.git" "$d" || {
			[ -z "$created" ] || rm -rf "${d:?}"
			failed "$n" "clone failed"; return 0; }
		fresh=1
	fi
	echo "$n: building"
	build "$n"; r=$?
	if [ "$r" -eq 0 ]; then
		echo "$n: installed $(branch "$n") $(short "$n")"
		setup_lines "$n"
		return 0
	fi
	[ -z "$fresh" ] || cleanup_fresh "$n" "$created"
	if [ "$r" -eq 2 ]; then echo "$n: SKIPPED (needs a newer ritz-get; run: ritz-get update)"; bump 1
	else fail "$n" "$WHY" "$BK"; fi
}

remove_one() {
	n=$1 d=$SRCDIR/$1
	valid "$n" || return 0
	[ "$n" != ritz-get ] || { err "to remove ritz-get run: $d/install.sh --remove, then delete $d"; bump 1; return 0; }
	if ! is_installed "$n"; then
		if lookup "$n"; then echo "$n: not installed"; else unknown "$n"; fi
		return 0
	fi
	if [ -x "$d/install.sh" ]; then
		run_script "$n" --remove
		[ "$RC" -eq 0 ] || { echo "$n: FAILED (install.sh --remove exit $RC; clone kept)"; bump 1; return 0; }
	fi
	rm -rf "${d:?}" && echo "$n: removed"
}

# ---- list ------------------------------------------------------------------------------
want() { [ -z "$WANT" ] || case $WANT in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# probe NAME SRC BRANCH: installed -> git fetch, else one ls-remote. Result: f.NAME (rc), r.NAME, e.NAME
probe() {
	if is_installed "$1"; then
		git -C "$SRCDIR/$1" fetch -q 2>"$TMP/e.$1" </dev/null
	else
		ref=HEAD; [ -z "$3" ] || ref=refs/heads/$3
		git ls-remote "$BASE/$2.git" "$ref" >"$TMP/r.$1" 2>"$TMP/e.$1" </dev/null
	fi
	echo $? >"$TMP/f.$1"
}
probed_ok() { [ "$(cat "$TMP/f.$1" 2>/dev/null)" = 0 ]; }

# inst_fields NAME: sets BRN VER HELD ST LAT BEH DIRTY AHEAD for an installed clone
inst_fields() {
	BRN=$(branch "$1" 2>/dev/null); VER=$(git -C "$SRCDIR/$1" log -1 --format='%cs %h' 2>/dev/null)
	HELD=0; ! held "$1" || HELD=1
	changes "$1"
	LAT=- BEH=- ST=unknown
	if [ -z "$OFF" ]; then
		if probed_ok "$1"; then
			LAT=$(git -C "$SRCDIR/$1" log -1 --format='%cs %h' '@{u}' 2>/dev/null)
			BEH=$(git -C "$SRCDIR/$1" rev-list --count 'HEAD..@{u}' 2>/dev/null)
			ST=current; [ "${BEH:-0}" -eq 0 ] || ST=behind
			[ -n "$LAT" ] || LAT=-; [ -n "$BEH" ] || BEH=0
		else ST=fetch-failed; fi
	fi
	if [ "$DIRTY" -gt 0 ] || [ "$AHEAD" -gt 0 ]; then ST=modified; fi
}

row() { printf 'E\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$@" >>"$TMP/rows"; }
irow() { # SEC NAME TITLE KIND SRC STATE DESC: row for an installed clone (after inst_fields)
	row "$1" "$2" "$3" "$4" "$5" "$6" "$ST" "$HELD" "${BRN:--}" "${VER:--}" "$LAT" "$BEH" "$DIRTY" "$AHEAD" "$7"
}

cmd_list() {
	[ $# -eq 0 ] || { WANT=" $* "; ALL=1; }
	for n; do lookup "$n" || is_installed "$n" || unknown "$n"; done
	OFF=$OFFLINE HIDDEN=0
	: >"$TMP/rows"
	unlisted >"$TMP/unl"
	if [ -z "$OFF" ] && lookup ritz-get; then	# ritz-get's own repo tells offline from "no access"
		probe ritz-get "$SRC" "$DEFBR"
		if ! probed_ok ritz-get || grep -q 429 "$TMP/e.ritz-get"; then OFF=1; fi
	fi
	if [ -z "$OFF" ]; then
		while IFS=$US read -r k _ n s b _ _; do
			[ "$k" = E ] && want "$n" || continue
			case $s in http://*|https://*) continue ;; esac
			[ -f "$TMP/f.$n" ] || probe "$n" "$s" "$b" &
		done <"$TMP/mf"
		while read -r n; do want "$n" && probe "$n" "" "" & done <"$TMP/unl"
		wait
	fi
	while IFS=$US read -r k sec n s b d t; do
		[ "$k" = E ] && want "$n" || continue
		case $s in
		http://*|https://*) row "$sec" "$n" "$t" website "$s" website - 0 - - - - - - "$d" ;;
		*)	if is_installed "$n"; then
				inst_fields "$n"; irow "$sec" "$n" "$t" program "$s" installed "$d"
			else
				st=available lat=-
				if [ -n "$OFF" ]; then st=offline
				elif ! probed_ok "$n"; then
					if grep -q 429 "$TMP/e.$n"; then st=offline; else st=unreachable; fi
				else lat=$(awk 'NR == 1 { print substr($1, 1, 7) }' "$TMP/r.$n"); fi
				if [ "$st" = unreachable ] && [ -z "$ALL" ]; then HIDDEN=$((HIDDEN + 1)); continue; fi
				row "$sec" "$n" "$t" program "$s" "$st" - 0 "${b:--}" - "${lat:--}" - - - "$d"
			fi ;;
		esac
		awk -F"$US" -v n="$n" '$1 == "S" && $2 == n { print "S\t" n "\t" $3 }' "$TMP/mf" >>"$TMP/rows"
	done <"$TMP/mf"
	while read -r n; do
		want "$n" || continue
		inst_fields "$n"; irow Unlisted "$n" "$n" program - unlisted ""
	done <"$TMP/unl"
	if [ -n "$PORC" ]; then
		echo "#porcelain 1"
		if [ -z "$OFF" ]; then echo "#online 1"; else echo "#online 0"; fi
		cat "$TMP/rows"
		if [ "$HIDDEN" -gt 0 ]; then echo "#hidden $HIDDEN"; fi
		return 0
	fi
	awk -F'\t' -v detail="${WANT:+1}" '
	$1 == "E" {
		if ($2 != sec) { if (sec != "") print ""; print $2; sec = $2 }
		h = 0; st = $8; s = ""
		if ($7 == "website") s = "website  " $6
		else if ($7 == "installed" || $7 == "unlisted") {
			if (st == "current") s = "up to date"
			else if (st == "behind") s = "update available: " $13 " behind, latest " $12
			else if (st == "modified") s = "modified: " $14 " changed files, " $15 " local commits"
			else if (st == "fetch-failed") s = "fetch failed"
			s = $10 " " $11 (s != "" ? "  " s : "")
			if ($9 == 1) s = s "  [held]"
			if ($7 == "unlisted") s = s "  (not in the manifest; only remove works)"
		}
		else if ($7 == "available") s = "not installed"
		else if ($7 == "offline") s = "not installed (offline)"
		else s = "no access"
		printf "  %-22s %-22s %s\n", $3, $4, s
		if ($16 != "") print "      " $16
		if (detail) print "      source: " $6
	}
	$1 == "S" && detail { if (!h++) print "      Additional steps required:"; print "        " $3 }' "$TMP/rows"
	[ "$HIDDEN" -eq 0 ] || echo "$HIDDEN program(s) hidden (no access)"
	[ -z "$OFF" ] || echo "offline: not checking for updates"
	return 0
}

# ---- update ----------------------------------------------------------------------------
# upd_check NAME: print the final status line, or queue NAME in $todo
upd_check() {
	n=$1 d=$SRCDIR/$1
	valid "$n" || { FL=$((FL + 1)); return 0; }
	if ! lookup "$n"; then
		if is_installed "$n"; then echo "$n: SKIPPED (not in the manifest; only remove works)"; SK=$((SK + 1))
		else failed "$n" "unknown program"; fi
		return 0
	fi
	[ "$KIND" = program ] || { echo "$n: website, nothing to update"; return 0; }
	is_installed "$n" || { failed "$n" "not installed; ritz-get install $n"; return 0; }
	if [ -z "$EXPL" ] && held "$n"; then echo "$n: held (ritz-get unhold $n)"; SK=$((SK + 1)); return 0; fi
	if modified "$n"; then
		echo "$n: SKIPPED (local changes; ritz-get reset $n to discard them)"; SK=$((SK + 1)); return 0
	fi
	git -C "$d" fetch -q || { fail "$n" "fetch failed"; return 0; }
	b=$(git -C "$d" rev-list --count 'HEAD..@{u}' 2>/dev/null)
	if [ "${b:-0}" -eq 0 ]; then echo "$n: up to date"; else todo="$todo $n"; fi
}

upd_apply() {
	n=$1 d=$SRCDIR/$1
	o=$(git -C "$d" rev-parse HEAD)
	git -C "$d" merge --ff-only -q '@{u}' >/dev/null 2>&1 || { fail "$n" "cannot fast-forward; ritz-get reset $n"; return 0; }
	build "$n"; r=$?
	if [ "$r" -eq 0 ]; then
		echo "$n: updated $(git -C "$d" rev-parse --short "$o") -> $(short "$n")"
		UP=$((UP + 1)); [ "$n" != ritz-get ] || SELFUP=1
		return 0
	fi
	git -C "$d" reset -q --keep "$o"
	if [ "$r" -eq 2 ]; then echo "$n: SKIPPED (needs a newer ritz-get)"; SK=$((SK + 1))
	else fail "$n" "$WHY" "$BK"; fi
}

upd_run() {
	todo=
	for n; do upd_check "$n"; done
	[ -n "$todo" ] || return 0
	if [ -z "$YES" ]; then
		echo "Will update:$todo"
		printf 'Continue? [y/N] '
		read -r a || a=
		case $a in y|Y|yes) ;; *) echo aborted; return 0 ;; esac
	fi
	for n in $todo; do upd_apply "$n"; done
}

cmd_update() {
	SUDO= SELFUP=
	[ -z "${RITZ_GET_SELF_UPDATED:-}" ] || UP=1
	if [ $# -eq 0 ]; then
		for n in $(awk -F"$US" '$1 == "E" && $4 !~ /^https?:/ { print $3 }' "$TMP/mf"); do
			! is_installed "$n" || set -- "$@" "$n"
		done
	else EXPL=1; fi
	rest= self=
	for n; do
		case $n in ritz-get) self=1 ;; *) case " $rest " in *" $n "*) ;; *) rest="$rest $n" ;; esac ;; esac
	done
	[ -z "${RITZ_GET_SELF_UPDATED:-}" ] || self=
	if [ -n "$self" ]; then
		upd_run ritz-get
		if [ -n "$SELFUP" ] && [ -n "$rest" ]; then	# continue in the new script; the lock fd stays open
			echo "ritz-get: updated itself, restarting"
			rm -rf "$TMP"
			RITZ_GET_SELF_UPDATED=1; export RITZ_GET_SELF_UPDATED
			# shellcheck disable=SC2086
			exec "$SRCDIR/ritz-get/ritz-get" update --yes ${EXPL:+$rest}
		fi
	fi
	[ -z "$rest" ] && [ -z "$self" ] && echo "no programs installed"
	# shellcheck disable=SC2086
	[ -z "$rest" ] || upd_run $rest
	s="$UP updated, $SK skipped, $FL failed"
	echo "$s"
	mkdir -p "$CACHE" && { echo "$(date +%Y-%m-%dT%H:%M:%S) $s"; [ "$FL" -eq 0 ] || echo "failed:$FNAMES"; } >"$CACHE/last-run"
	return 0
}

# ---- other commands --------------------------------------------------------------------
cmd_install() {
	[ $# -gt 0 ] || usage_err "install: no program given"
	for n; do install_one "$n"; done
}

cmd_remove() {
	[ $# -gt 0 ] || usage_err "remove: no program given"
	for n; do remove_one "$n"; done
}

cmd_branches() {
	[ $# -eq 1 ] || usage_err "usage: ritz-get branches NAME"
	n=$1; valid "$n" || return 0
	if is_installed "$n"; then
		c=$(branch "$n"); out=$(git -C "$SRCDIR/$n" ls-remote origin 'refs/heads/*'); rc=$?
	else
		lookup "$n" || { unknown "$n"; return 0; }
		[ "$KIND" = program ] || { err "$n is a website"; bump 1; return 0; }
		c=; out=$(git ls-remote "$BASE/$SRC.git" 'refs/heads/*'); rc=$?
	fi
	[ "$rc" -eq 0 ] || { err "$n: cannot reach the remote"; bump 1; return 0; }
	printf '%s\n' "$out" | awk -v c="$c" '{ b = $2; sub(/^refs\/heads\//, "", b); print (b == c ? "* " : "  ") b }'
}

cmd_switch() {
	[ $# -eq 2 ] || usage_err "usage: ritz-get switch NAME BRANCH"
	n=$1 b=$2 d=$SRCDIR/$1
	valid "$n" || return 0
	is_installed "$n" || { err "$n is not installed"; bump 1; return 0; }
	old=$(branch "$n"); [ "$old" != HEAD ] || old=$(git -C "$d" rev-parse HEAD)
	git -C "$d" fetch -q || { fail "$n" "fetch failed"; return 0; }
	git -C "$d" checkout -q "$b" 2>/dev/null || { fail "$n" "cannot check out '$b'; see: ritz-get branches $n"; return 0; }
	if ! git -C "$d" merge --ff-only -q '@{u}' >/dev/null 2>&1; then
		git -C "$d" checkout -q "$old"
		fail "$n" "cannot fast-forward $b to the remote; your local $b has diverged"; return 0
	fi
	echo "$n: building $b"
	build "$n"; r=$?
	if [ "$r" -eq 0 ]; then echo "$n: now on $b $(short "$n")"; return 0; fi
	git -C "$d" checkout -q "$old"
	if [ "$r" -eq 2 ]; then echo "$n: SKIPPED (needs a newer ritz-get)"; bump 1
	else fail "$n" "$WHY" "$BK"; fi
}

cmd_reset() {
	[ $# -eq 1 ] || usage_err "usage: ritz-get reset NAME [--yes]"
	n=$1 d=$SRCDIR/$1
	valid "$n" || return 0
	lookup "$n" || { unknown "$n"; return 0; }
	[ "$KIND" = program ] || { err "$n is a website"; bump 1; return 0; }
	is_installed "$n" || { err "$n is not installed (ritz-get install $n)"; bump 1; return 0; }
	changes "$n"
	if [ -z "$YES" ]; then
		echo "$n: reset deletes $DIRTY changed files, $AHEAD local commits and any hold, then re-clones ${DEFBR:-the default branch}"
		printf 'Continue? [y/N] '
		read -r a || a=
		case $a in y|Y|yes) ;; *) echo aborted; return 0 ;; esac
	fi
	new=$SRCDIR/.$n.new old=$SRCDIR/.$n.old
	rm -rf "${new:?}" "${old:?}"
	echo "$n: cloning $SRC${DEFBR:+ ($DEFBR)}"
	# shellcheck disable=SC2086
	git clone -q ${DEFBR:+-b "$DEFBR"} "$BASE/$SRC.git" "$new" || { rm -rf "${new:?}"; fail "$n" "clone failed"; return 0; }
	mv "$d" "$old" && mv "$new" "$d" || { mv "$old" "$d" 2>/dev/null; fail "$n" "cannot replace the clone"; return 0; }
	build "$n"; r=$?
	if [ "$r" -eq 0 ]; then
		rm -rf "${old:?}"; echo "$n: reset to $(branch "$n") $(short "$n")"; return 0
	fi
	rm -rf "${d:?}"; mv "$old" "$d"	# put the old clone back: same path, links still valid
	if [ "$r" -eq 2 ]; then echo "$n: SKIPPED (needs a newer ritz-get)"; bump 1
	else fail "$n" "$WHY" "$BK"; fi
}

# set_hold NAME true|false
set_hold() {
	valid "$1" || return 0
	is_installed "$1" || { err "$1 is not installed"; bump 1; return 0; }
	if [ "$2" = true ]; then git -C "$SRCDIR/$1" config ritz-get.hold true && echo "$1: held (update without a name skips it)"
	else git -C "$SRCDIR/$1" config --unset ritz-get.hold; echo "$1: not held"; fi
}
cmd_hold() { [ $# -gt 0 ] || usage_err "hold: no program given"; for n; do set_hold "$n" true; done; }
cmd_unhold() { [ $# -gt 0 ] || usage_err "unhold: no program given"; for n; do set_hold "$n" false; done; }

# ---- main ------------------------------------------------------------------------------
# lock: one changing ritz-get at a time (fd 9, released when the process dies)
lock() {
	LOCK=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/ritz-get.lock
	mkdir -p "$(dirname "$LOCK")" && exec 9>"$LOCK" || die "cannot open lock $LOCK"
	flock -n 9 && return 0
	[ "$cmd" = update ] && [ ! -t 0 ] && [ ! -t 1 ] && [ -z "${RITZ_GET_GUI:-}" ] && exit 0	# cron
	echo "busy: another ritz-get is running" >&2
	exit 5
}

main() {
	cmd=${1:-help}; [ $# -gt 0 ] && shift
	n=$#
	while [ "$n" -gt 0 ]; do
		a=$1; shift; n=$((n - 1))
		case $a in
		--yes|-y) YES=1 ;;
		--offline) OFFLINE=1 ;;
		--all) ALL=1 ;;
		--porcelain) PORC=1 ;;
		--branch|-b) [ $# -gt 0 ] || usage_err "$a needs a branch"; BR=$1; shift; n=$((n - 1)) ;;
		-h|--help) cmd=help ;;
		-*) usage_err "unknown option: $a" ;;
		*) set -- "$@" "$a" ;;
		esac
	done
	case $cmd in
	help|-h|--help) usage; exit 0 ;;
	list|install|update|remove|branches|switch|reset|hold|unhold) ;;
	uninstall) cmd=remove ;;
	*) usage >&2; exit 2 ;;
	esac

	SRCDIR=$(cfg dir)
	SRCDIR=${SRCDIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ritz-get/src}
	case $SRCDIR in "~/"*) SRCDIR=$HOME/${SRCDIR#"~/"} ;; esac
	if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
		XDG_RUNTIME_DIR=/run/user/$(id -u); export XDG_RUNTIME_DIR	# systemctl --user from cron
	fi
	TMP=$(mktemp -d) || die "cannot create a temp dir"
	trap 'rm -rf "$TMP"' EXIT
	trap 'exit 1' INT TERM HUP
	load_mf
	case $cmd in
	install|update|remove|switch|reset|hold|unhold)
		[ -n "${RITZ_GET_SELF_UPDATED:-}" ] || lock ;;	# after a self-update exec the fd is inherited
	esac
	# RITZ_GET_SUDO for install.sh: passed through if set (the GUI sets pkexec), else sudo on a terminal
	if [ "$cmd" = update ]; then SUDO=
	elif [ -n "${RITZ_GET_SUDO+x}" ]; then SUDO=$RITZ_GET_SUDO
	elif [ -t 0 ]; then SUDO=sudo
	else SUDO=; fi

	"cmd_$cmd" "$@"
	finish
}

main "$@"
exit
